# Local Next.js compatibility settings. For Cloudflare, prefer Worker Secrets or the page settings.
# Verify this sender domain in Resend first.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="到期提醒 <reminders@your-domain.com>"

# Required once to securely save a Resend API Key from the "邮件发送设置" panel.
# Generate a value with: openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-value

# Lets TypeSafe interpret human-written notes such as “到期前一周提醒我”.
# The application still works without this key and uses the selected reminder days.
TYPESAFE_API_KEY=ts_xxxxxxxxx

# Only required if you want to call /api/cron/send-reminders manually.
# Cloudflare Cron does not use this value.
CRON_SECRET=replace-with-a-long-random-value

# Optional. Defaults to Asia/Shanghai.
APP_TIME_ZONE=Asia/Shanghai

# Optional local development mode: mail is logged instead of delivered.
# EMAIL_DELIVERY_MODE=console
