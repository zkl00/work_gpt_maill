# Optional alternative to configuring Resend from the dashboard. Verify this sender domain in Resend first.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="到期提醒 <reminders@your-domain.com>"

# Required once to securely save a Resend API Key from the dashboard's "邮件发送设置" panel.
# Generate a value with: openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-value

# Optional alternative to page configuration: generic SMTP credentials.
# Use a provider-issued authorization code / app password, never the web login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-or-163-or-gmail@example.com
SMTP_PASSWORD=your-authorization-code-or-app-password
SMTP_FROM="到期提醒 <your-qq-or-163-or-gmail@example.com>"

# Lets TypeSafe interpret human-written notes such as “到期前一周提醒我”.
# The application still works without this key and uses the selected reminder days.
TYPESAFE_API_KEY=ts_xxxxxxxxx

# Required for the scheduled endpoint in production.
CRON_SECRET=replace-with-a-long-random-value

# Optional. Defaults to Asia/Shanghai.
APP_TIME_ZONE=Asia/Shanghai

# Optional local development mode: mail is logged instead of delivered.
# EMAIL_DELIVERY_MODE=console
